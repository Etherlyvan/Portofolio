SITE_URL=https://your-domain.example
PORTFOLIO_PORT=8080

# Public build settings only. KARI is optional and disabled until its service exists.
KARI_ENABLED=false
KARI_WIDGET_URL=/kari/embed.js
KARI_API_BASE=/kari/api
KARI_SITE_ID=portfolio
# Optional npm run dev proxy (set in the shell): KARI_DEV_PROXY_TARGET=http://127.0.0.1:3000
