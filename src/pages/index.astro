---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AboutExperience from '../components/sections/AboutExperience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Gallery from '../components/sections/Gallery.astro';
import Contact from '../components/sections/Contact.astro';
import ComicSeam from '../components/comic/ComicSeam.astro';
import '../styles/chapter-continuity.css';

---
<BaseLayout>
  <Hero />
  <div class="portfolio-chapters">
    <AboutExperience />
    <div class="comic-chapter chapter-projects"><Projects /><ComicSeam variant={2} /></div>
    <div class="comic-chapter chapter-skills"><Skills /><ComicSeam variant={3} /></div>
    <div class="comic-chapter chapter-gallery"><Gallery /><ComicSeam variant={4} /></div>
    <div class="comic-chapter chapter-contact"><Contact /><ComicSeam variant={5} /></div>
  </div>
</BaseLayout>
