---
import Experience from './Experience.astro';
import { assets, links } from '../../config/assets';
import ComicSeam from '../comic/ComicSeam.astro';
import '../../styles/editorial-v2.css';
---
<div class="editorial-v2">
  <div class="v2-city v2-city-left" aria-hidden="true"></div>
  <div class="v2-city v2-city-right" aria-hidden="true"></div>
  <section id="about" class="v2-about" aria-labelledby="v2-about-heading">
    <div class="v2-about-content">
      <h2 id="v2-about-heading" class="v2-heading"><span>01.</span><b>ABOUT ME</b></h2>
      <div class="v2-biography"><p>Software engineer with experience in full-stack development, ERP systems, and AI-powered applications. I enjoy solving real-world problems and building products that make an impact.</p></div>
      <ul class="v2-details">
        <li><span aria-hidden="true">&#9906;</span>Jakarta, Indonesia</li>
        <li><span aria-hidden="true">&#9678;</span>English, Japanese</li>
        <li><span aria-hidden="true">&#9993;</span><a href="mailto:jovanku1@gmail.com">jovanku1@gmail.com</a></li>
        <li><span aria-hidden="true">&#9635;</span>Open to opportunities</li>
        <li><span aria-hidden="true">&#9742;</span><a href="tel:+6281203742584">+62 812-3374-2584</a></li>
      </ul>
      <div class="v2-cv-row">{links.cv ? <a class="v2-cv" href={links.cv}>DOWNLOAD CV <span aria-hidden="true">&#8595;</span></a> : <button class="v2-cv" disabled title="CV available on request">DOWNLOAD CV <span aria-hidden="true">&#8595;</span></button>}<small class="v2-cv-caption">CV available on request.</small></div>
    </div>
    <figure class="v2-portrait"><img src={assets.about.person ?? ''} alt="Jovan enjoying coffee at a beachside cafe at dusk" width="1200" height="900" loading="lazy" /><figcaption>LET'S BUILD<br/>SOMETHING<br/>GREAT.</figcaption></figure>
  </section>
  <div class="about-seam"><ComicSeam variant={0} /></div>
  <Experience />
  <ComicSeam variant={1} />
</div>


