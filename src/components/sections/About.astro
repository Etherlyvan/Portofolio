---
import { assets, links } from '../../config/assets';
import ComicLabel from '../comic/ComicLabel.astro';
import PhotoFrame from '../comic/PhotoFrame.astro';
import PortfolioImage from '../ui/PortfolioImage.astro';
import ComicButton from '../ui/ComicButton.astro';
import EditorialEdges from '../comic/EditorialEdges.astro';
import '../../styles/about-experience.css';
---
<section id="about" class="comic-section about editorial-about">
  <EditorialEdges />
  <div class="section-inner">
    <div class="about-editorial-body">
      <div class="about-editorial-content">
        <ComicLabel number="01" title="ABOUT ME" />
        <div class="about-copy">
          <p>Software engineer with experience in full-stack development, ERP systems, and AI-powered applications. I enjoy solving real-world problems and building products that make an impact.</p>
          <ul class="info-grid">
            <li><span aria-hidden="true">⌖</span> Jakarta, Indonesia</li>
            <li><span aria-hidden="true">◎</span> English, Japanese</li>
            <li><span aria-hidden="true">✉</span> <a href="mailto:jovanku1@gmail.com">jovanku1@gmail.com</a></li>
            <li><span aria-hidden="true">▣</span> Open to opportunities</li>
            <li><span aria-hidden="true">↳</span> <a href="tel:+6281203742584">+62 812-3374-2584</a></li>
          </ul>
          <div class="about-cv-row"><ComicButton href={links.cv ?? undefined} disabled={!links.cv}>DOWNLOAD CV <span>↓</span></ComicButton>{!links.cv && <small class="availability">CV available on request.</small>}</div>
        </div>
      </div>
      <div class="about-art"><PhotoFrame><PortfolioImage src={assets.about.person} alt="Jovan’s professional portrait" label="REPLACE ABOUT PHOTO" width={720} height={960} /></PhotoFrame><p class="scribble paper-note">LET’S BUILD<br/>SOMETHING<br/>GREAT.</p></div>
    </div>
  </div>
</section>
